include ../../components/head/head
include ../../components/header/header
include ../../components/list-header/list-header
include ../../components/skill-card/skill-card
include ../../components/case-card/case-card
include ../../components/book-link/book-link
include ../../components/tag/tag
doctype html(prefix="og: http://ogp.me/ns#")
html
	+head(
		'Артём Самсонов • Продуктовый дизайнер',
        'Продуктовый дизайнер из Москвы и Петербурга',
        'http://artemsamsonov.com/img/default.jpg',
		''
	)
body.body_dark
	+header('dark')
	div#index
		div#main-info
			div#main-info-text.main-info Ведущий продуктовый дизайнер с&nbsp;12&#8209;летним опытом в&nbsp;B2B, B2C и&nbsp;HRTech. Проектирую цифровые продукты, масштабирую UX&#8209;процессы и&nbsp;улучшаю метрики роста
			div#main-info-pic
				img(src="../../img/profile-pic.jpg")
		div#skills
			+list-header('Компетенции', 'dark')
			+skillCard('Мыслю продуктово', 'Опираюсь на JTBD Advanced, дерево метрик и аналитику. Формулирую продуктовые гипотезы и OKR, участвую в планировании и декомпозиции, влияю на roadmap', '01')
			+skillCard('Провожу и координирую UX‑исследования', 'Глубинные интервью, user journey, юзабилити и A/B‑тесты. Сам провёл 50+ интервью, работал с ресёрчерами, внедрял результаты в продукт', '02')
			+skillCard('Развиваю дизайн‑системы', 'Полтора года отвечал за дизайн‑систему Wrike. Развивал 150+ компонентов, ревьюил дизайнеров в командах, писал документацию. Помогал с токенизацией и accessibility', '03')
			+skillCard('Проектирую интерфейсы в Figma', 'От вайрфреймов до интерактивных прототипов. Использую компоненты, вложенные структуры, переменные и плагины. Проектирую флоу с учётом бизнес‑целей и технических ограничений', '04')
			+skillCard('Пишу и редактирую продуктовые тексты', 'Для телеграм‑бота и рассылок getmatch. Координировал UX‑писателя, составлял writing‑гайды и проводил ревью, развивал tone of voice, повышал ясность', '05')
		div#cases
			+list-header('Кейсы getmatch', 'dark')
			div.cases__content
				+caseCard('case-04', 'Зарплатный калькулятор', 'Как я проектировал инструмент для аналитики зарплат в русском IT', 'getmatch-calc.html')
				+caseCard('case-05', 'Поднятие профиля', 'Механизм, помогающий кандидатам стать заметнее для компаний, а рекрутерам — находить кандидатов из глубины ленты', 'getmatch-up.html')
				+caseCard('case-06', 'Исследование персон кандидатов', 'Как мы сформировали персоны кандидатов в продукте и пользуемся ими до  сих пор', 'getmatch-personas.html')
			+list-header('Wrike • 2019–2022', 'dark').list-header-second
			div.cases__content
				+caseCard('case-01', 'Как перестать блуждать ёжиком в тумане и улучшать продукт разумно', 'Рассказываю на примере интеграции Wrike for MS Teams, как перестать делать лишнюю работу и реально помогать пользователям', 'msteams-rebuild.html')
				+caseCard('case-02', 'Как мы проектировали уведомления из Wrike в MS Teams', 'Рассказываю о проблемах, с которыми мы столкнулись в процессе проектирования и как мы решали их с помощью пользователей', 'msteams-notifications.html')
				+caseCard('case-03', 'Почему дизайнерам компонентов нужно доплачивать за вредность', 'Рассказываю на примере компонента «Календарь», как типичная на первый взгляд задача способна довести продуктового дизайнера до слёз', 'calendar-from-hell.html')
		div#tags
			+list-header('Инструменты и подходы', 'dark')
			div.tags__content
				div.tags__column
					h3 Подходы
					div.tags__wrap
						+tag('JTBD')
						+tag('Product Thinking')
						+tag('Data Driven Design')
						+tag('User Driven Design')
						+tag('Lean UX')
						+tag('Continuous Discovery')
				div.tags__column
					h3 Core-навыки
					div.tags__wrap
						+tag('UX Architecture')
						+tag('Interaction Design')
						+tag('Design Systems')
						+tag('UX Research')
						+tag('UX Writing')
						+tag('Design Review')
						+tag('Prototyping')
				div.tags__column
					h3 Метрики
					div.tags__wrap
						+tag('Retention')
						+tag('DAU/MAU')
						+tag('Time to Value')
						+tag('Task Success Rate')
						+tag('Completion Rate')
						+tag('Adoption')
						+tag('NPS')
				div.tags__column
					h3 Инструменты
					div.tags__wrap
						+tag('Figma')
						+tag('Design Tokens')
						+tag('Accessibility WCAG 2.2')
						+tag('HTML 5')
						+tag('CSS 4')
						+tag('Protopie')
						+tag('Amplitude')



