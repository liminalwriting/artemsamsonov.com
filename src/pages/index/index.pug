include ../../components/head/head
include ../../components/header/header
include ../../components/list-header/list-header
include ../../components/skill-card/skill-card
include ../../components/case-card/case-card
include ../../components/book-link/book-link
include ../../components/tag/tag
include ../../components/button/button
include ../../components/experience-card/experience-card
doctype html(prefix="og: http://ogp.me/ns#")
html
	+head(
		'Артём Самсонов •  Head of Product Design • Москва • UX/UI, UX research, дизайн-системы',
        'Head of Product Design. UX, исследования, дизайн-системы, UX-writing',
        'http://artemsamsonov.com/img/default.jpg',
		''
	)
	script(type="application/ld+json").
		{
		  "@context": "https://schema.org",
		  "@type": "WebSite",
		  "name": "Артём Самсонов, Head of Product Design, Москва",
		  "url": "https://artemsamsonov.com"
		}
body.body_dark
	+header('dark')
	div#index
		div#main-info
			div#main-info-text.main-info
				h1 Head of Product Design из Москвы. Создаю и&nbsp;развиваю команды, масштабирую UX&#8209;процессы, улучшаю метрики роста
				#main-info-buttons 
					+button('Опыт работы', '#experience')
					+button('Кейсы', '#cases')
		div#experience
			div.experience-cards
				+experienceCard(
					'2026–н.в.',
					'Mango Office',
					'../../img/getmatch.jpg',
					'Head of Product Design',
					'https://getmatch.ru',
					'Управляю отделом из 12 человек: дизайн&#8209;менеджер, 8&nbsp;продуктовых дизайнеров, 2 UX&#8209;исследователя, UX&#8209;писательница',
					'Создал с нуля дизайн&#8209;процесс: discovery, планирование, совместная работа, кросс&#8209;ревью, PBR, контроль разработки',
					'Ревьюил и&nbsp;помогал расти<br>(1:1, матрицы компетенций, ИПР, квартальные ревью)'
				)
				+experienceCard(
					'2022–2025',
					'getmatch',
					'../../img/getmatch.jpg',
					'Lead Product Designer',
					'https://getmatch.ru',
					'Нанял мультидисциплинарную команду дизайнеров: UX&nbsp;Researcher, UX&nbsp;Writer, Middle&nbsp;Product Designer',
					'Создал с нуля дизайн&#8209;процесс: discovery, планирование, совместная работа, кросс&#8209;ревью, PBR, контроль разработки',
					'Ревьюил и&nbsp;помогал расти<br>(1:1, матрицы компетенций, ИПР, квартальные ревью)'
				)
				+experienceCard(
					'2019–2022',
					'Wrike',
					'../../img/wrike.jpg',
					'Design System Owner',
					'https://wrike.com',
					'Развивал дизайн-систему из 180+ компонентов для&nbsp;18 дев-команд и&nbsp;1&nbsp;000&nbsp;000+ юзеров на проде',
					'Запускал кросскомандные инициативы (консистентность, токенизация, accessibility)',
					'Ревьюил 20 продуктовых дизайнеров, собеседовал и&nbsp;проверял тестовые'
				)
		#cases 
			+caseCard(
				'кейс getmatch',
				'Редизайн карточки кандидата',
				[
					{label: 'Time to Value', value: '-56%'},
					{label: 'Task Success Rate', value: '+18%'},
					{label: 'Выручка в месяц', value: '+972 000 ₽'}
				],
				'../../img/getmatch-card-preview.png',
				'Редизайн карточки кандидата getmatch',
				'Смотреть кейс',
				'getmatch-card.html',
				false
			)
			+caseCard(
				'кейс getmatch',
				'One Day Offer для\u00A0кандидатов',
				[
					{label: 'Эффективность откликов', value: '+212%'},
					{label: 'Продажи за месяц', value: '+1 500 000 ₽'}
				],
				'../../img/getmatch-odo-preview.jpg',
				'One Day Offer для кандидатов getmatch',
				'Смотреть кейс',
				'getmatch-odo.html',
				false
			)
		div#skills
			+list-header('Как играющий тренер', 'dark')
			+skillCard(
				'Мыслю продуктово',
				'Опираюсь на JTBD, дерево метрик и\u00A0аналитику. Формулирую продуктовые гипотезы и\u00A0OKR, участвую в\u00A0планировании и\u00A0декомпозиции, влияю на\u00A0roadmap',
				'01'
			)
			+skillCard(
				'Провожу и\u00A0координирую UX‑исследования',
				'Глубинные интервью, user journey, юзабилити- и\u00A0A/B‑тесты. Сам провёл 50+ интервью, работал с\u00A0ресёрчерами, внедрял результаты в\u00A0продукт',
				'02'
			)
			+skillCard(
				'Развиваю дизайн‑системы',
				'Полтора года отвечал за\u00A0дизайн‑систему Wrike. Развивал 150+ компонентов, ревьюил дизайнеров в\u00A0командах, писал документацию. Помогал с\u00A0токенизацией и\u00A0accessibility',
				'03'
			)
			+skillCard(
				'Проектирую интерфейсы в\u00A0Figma',
				'От вайрфреймов до\u00A0интерактивных прототипов. Использую компоненты, вложенные структуры, переменные и\u00A0плагины. Проектирую флоу с\u00A0учётом бизнес‑целей и\u00A0технических ограничений',
				'04'
			)
			+skillCard(
				'Пишу и\u00A0редактирую продуктовые тексты',
				'Для телеграм‑бота и\u00A0рассылок getmatch. Координировал UX‑писателя, составлял writing‑гайды и\u00A0проводил ревью, развивал tone of\u00A0voice, повышал ясность',
				'05'
			)
		div#tags
			+list-header('Инструменты и подходы', 'dark')
			div.tags__content
				div.tags__column
					h4 Подходы
					div.tags__wrap
						+tag('JTBD', 'S')
						+tag('Product Thinking', 'S')
						+tag('Data Driven Design', 'S')
						+tag('User Driven Design', 'S')
						+tag('Lean UX', 'S')
						+tag('Continuous Discovery', 'S')
				div.tags__column
					h4 Core-навыки
					div.tags__wrap
						+tag('UX Architecture', 'S')
						+tag('Interaction Design', 'S')
						+tag('Design Systems', 'S')
						+tag('UX Research', 'S')
						+tag('UX Writing', 'S')
						+tag('Design Review', 'S')
						+tag('Prototyping', 'S')
				div.tags__column
					h4 Метрики
					div.tags__wrap
						+tag('Retention', 'S')
						+tag('DAU/MAU', 'S')
						+tag('Time to Value', 'S')
						+tag('Task Success Rate', 'S')
						+tag('Completion Rate', 'S')
						+tag('Adoption', 'S')
						+tag('NPS', 'S')
				div.tags__column
					h4 Инструменты
					div.tags__wrap
						+tag('Figma', 'S')
						+tag('Design Tokens', 'S')
						+tag('Accessibility WCAG 2.2', 'S')
						+tag('HTML 5', 'S')
						+tag('CSS 4', 'S')
						+tag('Protopie', 'S')
						+tag('Amplitude', 'S')