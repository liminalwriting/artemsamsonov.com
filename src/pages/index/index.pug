include ../../components/head/head
include ../../components/header/header
include ../../components/list-header/list-header
include ../../components/skill-card/skill-card
include ../../components/case-card/case-card
include ../../components/book-link/book-link
include ../../components/tag/tag
include ../../components/button/button
include ../../components/experience-card/experience-card
doctype html(prefix="og: http://ogp.me/ns#")
html
	+head(
		'Артём Самсонов •  Head of Product Design • Москва • UX/UI, UX research, дизайн-системы • Mango Office',
        'Head of Product Design • UX, исследования, дизайн-системы, UX-writing • Mango Office',
        'http://artemsamsonov.com/img/default.jpg',
		''
	)
	script(type="application/ld+json").
		{
		  "@context": "https://schema.org",
		  "@type": "WebSite",
		  "name": "Артём Самсонов, Head of Product Design, Москва, Mango Office",
		  "url": "https://artemsamsonov.com"
		}
body.body_dark
	+header('dark')
	div#index
		div#main-info
			div#main-info-text.main-info
				h1 Head&nbsp;of&nbsp;Product&nbsp;Design из&nbsp;Москвы. Создаю и&nbsp;развиваю команды, выстраиваю дизайн&#8209;стратегию, ускоряю&nbsp;процессы с&nbsp;помощью AI
				#main-info-buttons 
					+button('Опыт и достижения', '#experience')
					//+button('Кейсы', '#cases')
		div#experience
			div.experience-cards
				+experienceCard(
					'2025–н.в., <span id="experience-tenure-mango"></span>',
					'Mango Office',
					'../../img/mango.jpg',
					'Head of Product Design',
					'Отдел из 12 человек: designOps, 8&nbsp;продуктовых дизайнеров, 2&nbsp;UX&#8209;исследователя, UX&#8209;писательница',
					'Разработал дизайн&#8209;стратегию компании до&nbsp;2028 года, интегрированную в&nbsp;продуктовый роадмап',
					'Внедрил регулярный процесс дизайн-ревью, TTD&nbsp;-15%',
					'Перезапустил дизайн-систему: уже +10&nbsp;паттернов, +15&nbsp;новых компонентов; TTM&nbsp;coming soon'
				)
				+experienceCard(
					'2025–2022',
					'getmatch',
					'../../img/getmatch.jpg',
					'Product Design Lead',
					'Мультидисциплинарная команда: 2&nbsp;продуктовых дизайнера, UX&#8209;исследователь, UX&#8209;писательница',
					'Создал с нуля дизайн&#8209;процесс: discovery, планирование, совместная работа, кросс&#8209;ревью, PBR, контроль разработки',
					'Нанимал, ревьюил и&nbsp;помогал расти<br>(1:1, матрицы компетенций, ИПР, квартальные ревью)',
					'Редизайн карточки увеличил ключевую метрику «Открытия контактов» на 18%'
				)
				+experienceCard(
					'2019–2022',
					'Wrike',
					'../../img/wrike.jpg',
					'Design System Designer',
					'Развивал дизайн-систему из 180+ компонентов для&nbsp;18 дев-команд и&nbsp;1&nbsp;000&nbsp;000+ юзеров на проде',
					'Запускал кросскомандные инициативы (консистентность, токенизация, accessibility)',
					'Ревьюил 20 продуктовых дизайнеров, собеседовал и&nbsp;проверял тестовые'
				)
		//#cases 
			+caseCard(
				'кейс getmatch',
				'Редизайн карточки кандидата',
				[
					{label: 'Time to Value', value: '-56%'},
					{label: 'Task Success Rate', value: '+18%'},
					{label: 'Выручка в месяц', value: '+972 000 ₽'}
				],
				'../../img/getmatch-card-preview.png',
				'Редизайн карточки кандидата getmatch',
				'Смотреть кейс',
				'getmatch-card.html',
				false
			)
			+caseCard(
				'кейс getmatch',
				'One Day Offer для\u00A0кандидатов',
				[
					{label: 'Эффективность откликов', value: '+212%'},
					{label: 'Продажи за месяц', value: '+1 500 000 ₽'}
				],
				'../../img/getmatch-odo-preview.jpg',
				'One Day Offer для кандидатов getmatch',
				'Смотреть кейс',
				'getmatch-odo.html',
				false
			)
		div#skills
			+list-header('Чему могу научить дизайнеров', 'dark')
			+skillCard(
				'Мыслить продуктово',
				'Опираться на JTBD, дерево метрик и\u00A0аналитику. Формулировать продуктовые гипотезы и\u00A0OKR, влиять на\u00A0роадмап',
				'01'
			)
			+skillCard(
				'Внедрять и замерять метрики',
				'На дизайн-уровне: UMUX, SUS, VisAWI, Task Success Rate; процессные: TTD, TTM; научу соединять их с продуктовым слоем (Adoption, Activation, Retention, CSAT, NPS, etc.) и далее вплоть до P&L',
				'02'
			)
			+skillCard(
				'Переходить на AI Product Design',
				'Создавать проекты и агентов для текущих задач в Claude и Perplexity, вайбкодить прототипы на базе UI Kit и ДС в Cursor/Codex. Принесу с собой агентов для конкурентного анализа, поиска теоретических аргументов, AI-Design-System-Ownerа, AI-UX-редактора, AI-UX-ресерчера и модератора нейроперсон, транскрибатора интервью, инструмент прототипирования на стеке Cursor + Figma MCP. Расскажу про v0, Claude Code и Claude Design, Loveable, Figma AI, Open Design, OpenAI',
				'03'
			)
			+skillCard(
				'Проводить UX‑исследования',
				'Глубинные интервью, user journey, юзабилити- и\u00A0A/B‑тесты, количественные опросы, анкеты, регулярные метрики, карточные сортировки',
				'04'
			)
			+skillCard(
				'Развивать дизайн‑системы',
				'Проектировать и\u00A0внедрять компоненты в\u00A0коде, а\u00A0не рисовать их в\u00A0Figma, замерять эффект (CRR, TTD, TTM), запускать кросскомандные инициативы, писать паттерны, принципы, развивать ДС как\u00A0продукт внутри компании, заражать команды и\u00A0продукты общей\u00A0идеей',
				'05'
			)
			+skillCard(
				'Проектировать интерфейсы в\u00A0Figma',
				'От вайрфреймов до\u00A0интерактивных прототипов. Использовать компоненты, вложенные структуры, переменные и\u00A0плагины. Работать с\u00A0Figma AI и\u00A0MCP',
				'06'
			)
			+skillCard(
				'Писать и\u00A0редактировать продуктовые тексты',
				'Системно, а\u00A0не\u00A0хаотично. Составлять ux-writing‑гайды и\u00A0проводить ревью, развивать tone\u00A0of\u00A0voice, влиять на\u00A0метрики с\u00A0помощью текстов',
				'07'
			)
		//div#tags
			+list-header('Инструменты и подходы', 'dark')
			div.tags__content
				div.tags__column
					h4 Подходы
					div.tags__wrap
						+tag('JTBD', 'S')
						+tag('Product Thinking', 'S')
						+tag('Data Driven Design', 'S')
						+tag('User Driven Design', 'S')
						+tag('Lean UX', 'S')
						+tag('Continuous Discovery', 'S')
				div.tags__column
					h4 Core-навыки
					div.tags__wrap
						+tag('UX Architecture', 'S')
						+tag('Interaction Design', 'S')
						+tag('Design Systems', 'S')
						+tag('UX Research', 'S')
						+tag('UX Writing', 'S')
						+tag('Design Review', 'S')
						+tag('Prototyping', 'S')
				div.tags__column
					h4 Метрики
					div.tags__wrap
						+tag('Retention', 'S')
						+tag('DAU/MAU', 'S')
						+tag('Time to Value', 'S')
						+tag('Task Success Rate', 'S')
						+tag('Completion Rate', 'S')
						+tag('Adoption', 'S')
						+tag('NPS', 'S')
				div.tags__column
					h4 Инструменты
					div.tags__wrap
						+tag('Figma', 'S')
						+tag('Design Tokens', 'S')
						+tag('Accessibility WCAG 2.2', 'S')
						+tag('HTML 5', 'S')
						+tag('CSS 4', 'S')
						+tag('Protopie', 'S')
						+tag('Amplitude', 'S')