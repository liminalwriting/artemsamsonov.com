//- Шаблон кейса.
//- 1. Скопируй папку и назови Pug-файл так же, как новую папку.
//- 2. Замени мета, hero, теги, изображения и текстовые плейсхолдеры.
//- 3. Удали noindex перед публикацией.

include ../../components/head/head
include ../../components/header/header
include ../../components/tag/tag
include ../../components/skill-card/skill-card

doctype html
html
    +head(
      'Название кейса • Артём Самсонов • Продуктовый дизайнер',
      'Короткое описание кейса и&nbsp;его результата',
      'https://artemsamsonov.com/img/default.jpg',
      'article'
    )
    meta(name="robots" content="noindex, nofollow")
body.body_dark
    +header('dark')

    //- Hero-фон задаётся через CSS-переменную. Путь считается от css/style.bundle.css,
    //- поэтому он начинается с ../img/, а не от HTML-страницы.
    div.article__hero(style="--article-hero-image: url(../img/default.jpg)")
        div.article__hero-content
            h1 Название продукта или&nbsp;проекта
            p.article__annotation Одним предложением: что изменилось для&nbsp;пользователей и&nbsp;бизнеса после релиза.
            div.article__tags
                +tag('Роль в&nbsp;проекте', 'S')
                +tag('Исследования', 'S')
                +tag('Проектирование', 'S')
                +tag('Арт-дирекшен', 'S')

    div.content.content_grid
        div.article
            //- Каждый смысловой блок — отдельная section с одним h2 внутри.
            section
                h2 Контекст
                p Опиши продукт, аудиторию и&nbsp;исходную ситуацию. Оставь только факты, необходимые для&nbsp;понимания задачи.
                p Объясни проблему пользователей и&nbsp;бизнеса: что не&nbsp;работало, как это проявлялось и&nbsp;почему стоило вмешаться.

            //- Опциональная секция сравнения. Первое изображение — «до»,
            //- второе — «после». Удали её целиком, если сравнение не нужно.
            section
                div.article__compare-heading
                    h2 До и&nbsp;после
                    img(
                        src="../../img/hand-drag.png"
                        alt="hand-drag"
                        width="30"
                        height="30"
                    )
                div.article__compare
                    div.article__compare-labels
                        span После
                        span До
                    div.article__compare-frame
                        img.article__compare-before(src="../../img/case-01.jpg" alt="Интерфейс до&nbsp;изменений")
                        img.article__compare-after(src="../../img/case-02.jpg" alt="Интерфейс после изменений")
                        div.article__compare-handle(
                            role="slider"
                            tabindex="0"
                            aria-label="Шторка сравнения: влево — до, вправо — после"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="50"
                        )
                            div.tag.tag--S
                    //- Кнопка нужна только для высоких изображений, которые не помещаются
                    //- в кадр. Для широких скриншотов удали её — шторка работает и без неё.
                    button.article__compare-toggle(type="button" aria-expanded="false") Развернуть на&nbsp;всю высоту

            section
                h2 Решение
                h3 Этап 1. Исследование
                p Опиши метод, выборку и&nbsp;выводы, которые повлияли на&nbsp;решение.
                ul
                    li Первый важный вывод
                    li Второй важный вывод
                    li Третий важный вывод

                h3 Этап 2. Проектирование
                p Покажи, как выводы превратились в&nbsp;сценарий, структуру и&nbsp;интерфейс.

            section
                h2 Подробности
                .article__skill-cards
                    +skillCard(
                        'Название изменения',
                        'Что изменилось и&nbsp;почему это стало лучше для&nbsp;пользователя.',
                        '',
                        'default',
                        'case'
                    )
                    +skillCard(
                        'Название второго изменения',
                        'Короткое объяснение решения и&nbsp;его продуктового смысла.',
                        '',
                        'default',
                        'case'
                    )

            section
                h2 Результаты
                .article__skill-cards
                    +skillCard(
                        'Ключевая метрика: +00%',
                        'Что измеряли, за&nbsp;какой период и&nbsp;с&nbsp;чем сравнивали.',
                        '',
                        'metric',
                        'case'
                    )
                    +skillCard(
                        'Бизнес-результат',
                        'Как решение повлияло на&nbsp;деньги, скорость или&nbsp;качество процесса.',
                        '',
                        'metric',
                        'case'
                    )
