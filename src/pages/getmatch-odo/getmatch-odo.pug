include ../../components/head/head
include ../../components/header/header
include ../../components/article-headline/article-headline
include ../../components/article-breadcrumb/article-breadcrumb
include ../../components/tag/tag
include ../../components/skill-card/skill-card
include ../../components/sign/sign

doctype html
html
    +head(
      'Зарплатный калькулятор getmatch • Артём Самсонов • Продуктовый дизайнер',
      'Дизайн сервиса на пересечении интересов кандидатов и клиентов',
      'http://artemsamsonov.com/img/case-04.jpg',
      'article'
    )
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          "name": "One Day Offer для кандидатов getmatch",
          "alternateName": "One Day Offer for Candidates getmatch",
          "headline": "Улучшение UX уведомлений для кандидатов",
          "description": "Кейс о том, как я улучшил UX уведомлений в getmatch. Новый подход к коммуникации с кандидатами увеличил эффективность откликов и привел к росту продаж.",
          "url": "https://artemsamsonov.com/getmatch-odo",
          "author": {
            "@type": "Person",
            "name": "Артём Самсонов",
            "url": "https://artemsamsonov.com"
          },
          "datePublished": "2025-06-26",
          "dateModified": "2025-06-26",
          "inLanguage": "ru",
          "mainEntityOfPage": "https://artemsamsonov.com/getmatch-odo",
          "image": {
            "@type": "ImageObject",
            "url": "https://artemsamsonov.com/img/getmatch-card-01.png",
            "width": 1152,
            "height": 768
          }
        }
body.body_dark
    +header('dark')
    div.article__hero
        div.article__hero-content
            h1 One Day Offer для кандидатов
            p.article__annotation Редизайн механики увеличил среднее количество откликов на 212% и принёс 1 500 000 ₽ продаж за первый месяц после релиза.
            h3 Мой вклад
            div.article__tags
                +tag('Сбор бизнес-требований', 'M')
                +tag('UX-исследование кандидатов', 'M')
                +tag('Определение и анализ метрик', 'M')
                +tag('Арт-дирекшен дизайна', 'M')
    div.content.content_grid
        div.article
            section
                div.article__pair
                    div.article__image
                        a(href="../../img/getmatch-odo-old.jpg" target="_blank")
                            div.article__image-frame
                                img(src="../../img/getmatch-odo-old.jpg")
                        span.article__image-caption Так выглядела страница до редизайна
                    div.article__image
                        a(href="../../img/getmatch-odo-01.jpg" target="_blank")
                            div.article__image-frame
                                img(src="../../img/getmatch-odo-01.jpg")
                        span.article__image-caption Версия после редизайна
                    button.article__pair-toggle(type="button" aria-expanded="false") Развернуть на&nbsp;всю высоту
                h3 Контекст
                p One Day Offer (ODO) — мероприятие, на котором кандидаты проходят все этапы собеседования за день. getmatch продавал компаниям ODO под ключ.
                p Однако, презентация услуги хромала — кандидаты не понимали, чем One Day Offer лучше обычного отклика на вакансию. Компании получали мало откликов и не понимали, почему One Day Offer дороже обычной вакансии в 5 раз.
                h2 Решение
                h3 Этап 1 → Исследование ценности ODO
                p  Провели опрос кандидатов в телеграм-боте, которые уже откликались на One Day Offer. Спрашивали о причинах отклика. Получили следующие результаты:
                    ul
                        li Возможность пройти собеседование за день (выбрали 80% респондентов)
                        li Онлайн-формат всех этапов (45%)
                        li Желание попасть именно в эту компанию (28%)
                        li Желание получить обратную связь (17%)
                        li Другое (писали в свободной форме)
                    p Параллельно собрали данные о том, какую информацию считают важными рекрутеры: даты проведения мероприятия, этапы, перечень требуемых скиллов и команд.
                h3 Этап 2 → Новый дизайн страницы ODO
                p Опираясь на данные с двух сторон, спроектировали новую страницу →
                h2 Подробности
                .article__skill-cards
                    +skillCard(
                        'Сделали шапку кастомной и презентабельной',
                        'Компании смогли загружать свои графические материалы, ODO визуально стали отличаться от обычных вакансий',
                        '',
                        'default',
                        'case'
                    )
                    +skillCard(
                        'Показали таймлайн мероприятия',
                        'Раньше этапы описывали текстом, теперь стало понятно, как мероприятия следуют друг за другом',
                        '',
                        'default',
                        'case'
                    )
                    +skillCard(
                        'Добавили детальное описание опыта',
                        '100% респондентов ходили в полный профиль именно за ним. Добавили спойлером, чтобы не растягивать карточку (некоторые кандидаты пишут в них «Войну и мир»)',
                        '',
                        'default',
                        'case'
                    )
                    +skillCard(
                        'Отобразили контакты в сайдбаре',
                        'Раньше открыть их можно было только в полном профиле',
                        '',
                        'default',
                        'case'
                    )
               
                h2 Результаты
                .article__skill-cards
                    +skillCard(
                        'Time to Value: -56%',
                        'Время принятия решения сократилось с 2 минут 40 сек. до 1 минуты 10 сек. — за счёт избавления от лишнего перехода в полный профиль и быстрого доступа к важной информации',
                        '',
                        'metric',
                        'case'
                    )
                    +skillCard(
                        'Task Success Rate: +18%',
                        'Рекрутеры стали открывать больше контактов',
                        '',
                        'metric',
                        'case'
                    )
                    +skillCard(
                        'Выручка в месяц: +972 000 ₽',
                        'Больше открытий контактов → больше собеседований → больше наймов. А за наймы нам платили деньги',
                        '',
                        'metric',
                        'case'
                    )
                