include ../../components/head/head
include ../../components/header/header
include ../../components/article-headline/article-headline
include ../../components/article-breadcrumb/article-breadcrumb
include ../../components/tag/tag
include ../../components/sign/sign

doctype html
html
    +head(
      'Зарплатный калькулятор getmatch • Артём Самсонов • Продуктовый дизайнер',
      'Дизайн сервиса на&nbsp;пересечении интересов кандидатов и&nbsp;клиентов',
      'http://artemsamsonov.com/img/case-04.jpg',
      'article'
    )
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          "name": "Зарплатный калькулятор getmatch",
          "alternateName": "Salary Calculator getmatch",
          "headline": "Инструмент для оценки рыночной зарплаты кандидата",
          "description": "Кейс о том, как я спроектировал зарплатный калькулятор в getmatch. Простой инструмент помогал кандидатам оценить свою рыночную зарплату, а клиентам — понимать, сколько платить IT-специалистам.",
          "url": "https://artemsamsonov.com/getmatch-calc",
          "author": {
            "@type": "Person",
            "name": "Артём Самсонов",
            "url": "https://artemsamsonov.com"
          },
          "datePublished": "2025-06-26",
          "dateModified": "2025-06-26",
          "inLanguage": "ru",
          "mainEntityOfPage": "https://artemsamsonov.com/getmatch-calc",
          "image": {
            "@type": "ImageObject",
            "url": "https://artemsamsonov.com/img/case-04.jpg",
            "width": 1152,
            "height": 768
          }
        }
body.body_light
    +header()
    div.content
        div.article
            section
                h1 Зарплатный калькулятор getmatch
                p.article__annotation Раздел сервиса на&nbsp;пересечении интересов кандидатов и&nbsp;клиентов.
                h2 Мой вклад
                div.article__tags
                    +tag('Глубинные интервью', 'S')
                    +tag('Формулировка JTBD', 'S')
                    +tag('Архитектура сценариев', 'S')
                    +tag('UX/UI-дизайн', 'S')
                    +tag('UX-редактура', 'S')
                    +tag('Спецификации', 'S')
                    +tag('Сопровождение разработки', 'S')
                h2 Проблема
                .article__2-cols
                    .article__col  
                        h3 Для&nbsp;кандидатов
                        p На&nbsp;серии глубинных интервью кандидаты отмечали, что не&nbsp;понимают, достаточно ли им платят
                    .article__col
                        h3 Для&nbsp;клиентов
                        p Компании не&nbsp;понимали, сколько платить — им нужна была аналитика, основанная на #[em реальных] данных
                h2 Job to be Done
                .article__2-cols
                    .article__col
                        h3 Для&nbsp;кандидата
                        p Понять, справедливо ли мне платят и&nbsp;какие условия я могу просить у&nbsp;компаний
                    .article__col 
                            h3 Для&nbsp;компаний
                            p Определить зарплатную вилку, которую предлагать кандидатам и&nbsp;сотрудникам
                h2 Задача
                p Создать решение, которое:
                ul
                    li даст кандидатам понимание, насколько их зарплата соответствует рынку
                    li мотивирует делиться зарплатой добровольно
                    li позволит компаниям покупать агрегированную аналитику
                h2 Решение
                p  Новый раздел «Зарплаты» показывает график зарплат по&nbsp;специальности. Чтобы посмотреть статистику по&nbsp;уровням, городам, форматам и&nbsp;топ-компаниям, нужно анонимно оставить зарплату.
                
                p Сразу показали товар лицом, закрыв платные значения заглушками:
                p.article__image
                    a(href="../img/getmatch-calc-01.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-01.jpg")
                p В&nbsp;форме добавления объяснили, зачем нам понадобилось каждое из&nbsp;полей:
                p.article__image
                    a(href="../img/getmatch-calc-02.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-02.jpg")
                    span.article__image-caption Например, при&nbsp;выборе компании
                p.article__image
                    a(href="../img/getmatch-calc-02b.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-02b.jpg")
                    span.article__image-caption …или&nbsp;при&nbsp;указании опыта
                p Провалидировали все необходимые ошибки ввода:
                p.article__image
                    a(href="../img/getmatch-calc-03.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-03.jpg")
                p При&nbsp;попытке добавить зарплату без&nbsp;нужных данных подсветили пользователю, какие поля придётся заполнить:
                p.article__image
                    a(href="../img/getmatch-calc-04.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-04.jpg")
                    span.article__image-caption Придётся всё же указать зарплату и&nbsp;город проживания
                p Добавление зарплаты не&nbsp;только разблокирует фильтры, но&nbsp;и&nbsp;позволит оценить своё положение на&nbsp;рынке:
                p.article__image
                    a(href="../img/getmatch-calc-05.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-05.jpg")
                p У&nbsp;зарплат выше, по&nbsp;рынку или&nbsp;ниже рынка есть цветовые индикаторы:
                p.article__image
                    a(href="../img/getmatch-calc-06.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-06.jpg")
                p Зарплату можно скрыть от&nbsp;чужих глаз, чтобы заскриншотить данные друзьям или&nbsp;не&nbsp;прятаться в&nbsp;опенспейсе:
                p.article__image
                    a(href="../img/getmatch-calc-07.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-07.jpg")
                p Если зарплат не&nbsp;хватает, покажем заглушку и&nbsp;позже пришлём оповещение в&nbsp;телеграм-бот:
                p.article__image
                    a(href="../img/getmatch-calc-08.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-08.jpg")
                p У&nbsp;всех страниц, компонентов и&nbsp;состояний есть адаптивные версии:
                p.article__image
                    a(href="../img/getmatch-calc-10.jpg" target="_blank")
                        img(src="../../img/getmatch-calc-10.jpg")
                p В&nbsp;рамках задачи провели с&nbsp;UX-писателем серьёзную работу над&nbsp;формулировками. Я руководил процессом и&nbsp;ревьюил варианты:
                    p.article__image
                        a(href="../img/getmatch-calc-11b.jpg" target="_blank")
                            img(src="../../img/getmatch-calc-11b.jpg")
                        span.article__image-caption Несколько вариаций обсуждаемых формулировок
                    p.article__image
                        a(href="../img/getmatch-calc-11.jpg" target="_blank")
                            img(src="../../img/getmatch-calc-11.jpg")
                        span.article__image-caption Пример обсуждения
                    p Разработчикам передали не&nbsp;только подробные макеты, но&nbsp;и&nbsp;текстовые спецификации с&nbsp;прототипами.
                    p
                        a(href="https://www.figma.com/proto/gRAEj3xOESxAVwgkzbZjJo/%E2%9C%85-Calc-%E2%86%92-Iteration-1?page-id=701%3A45383&node-id=794-55069&p=f&viewport=455%2C342%2C0.16&t=JKYRqaQhiauFifht-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=794%3A55069" target="_blanc") Пример кликабельного прототипа
                h2 Результаты
                ul 
                    li MAU сервиса вырос на #[attr NDA] п.п. (→ просмотры вакансий → отклики → одобрения → наймы → выручка)
                    li Компании купили обощённую аналитику на #[attr NDA] миллионов рублей в&nbsp;первом же квартале (→ выручка)
                p #[strong Фан-факт:] кнопка «Открыть профиль» в&nbsp;кейсе «Ваша зарплата ниже рынка» подняла открытие профилей. Однако, к&nbsp;росту наймов это не&nbsp;привело — чаще всего профили открывали маловостребованные специалисты уровня junior.
                h2 Чему я научился
                p Принцип #[a(href="https://www.nngroup.com/articles/progressive-disclosure/") Progressive Disclosure (nngroup.com)] работает — если пользователь видит даже заблюренную ценность, он готов поделиться чувствительными данными.
                p Маленькие и&nbsp;на&nbsp;первый взгляд необязательные детали важны. Цветная маркировка позиции на&nbsp;рынке, скрытие зарплаты — недорогие в&nbsp;разработке вещи, но&nbsp;дарят пользователю ощущение заботы и&nbsp;аккуратности (#[a(href="https://www.nngroup.com/articles/peak-end-rule/") Peak–End Rule], Daniel Kahneman, 1999).
                +sign()
                