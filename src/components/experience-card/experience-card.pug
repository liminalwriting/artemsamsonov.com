mixin experienceCard(years, company, image, position, link, descr, ...descriptions)
    a.experience-card(href=link, target="_blank", rel="noopener noreferrer")
        .experience-card__content
            h3.experience-card__company= company
            .experience-card__years!= years
        .experience-card__image
            if image.endsWith('.mp4') || image.endsWith('.webm') || image.endsWith('.ogg')
                video(src=image, muted, loop, playsinline, autoplay, preload="auto")
            else
                img(src=image, alt=company)
        .experience-card__details
            .experience-card__position= position
            .experience-card__description
                p.experience-card__item!= descr
                each description in descriptions
                    .experience-card__item!= description
