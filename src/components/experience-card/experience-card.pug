mixin experienceCard(years, company, image, position, descr, ...descriptions)
    .experience-card
        .experience-card__content
            .experience-card__company= company
            .experience-card__years!= years
        .experience-card__position
            .experience-card__position-media
                img(src=image, alt=company)
            .experience-card__position-name= position
            p.experience-card__position-descr!= descr
        .experience-card__details
            .experience-card__description
                each description in descriptions
                    .experience-card__item!= description
