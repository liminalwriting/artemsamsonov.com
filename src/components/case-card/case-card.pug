mixin caseCard(type, title, metrics, imageSrc, imageAlt, buttonText, buttonLink, reverse = false)
  .case(class=reverse ? 'case--reverse' : '')
    if reverse
      .case__image
        img(src=imageSrc, alt=imageAlt)
      .case__content
        span.case__type= type
        h2= title
        .case__metrics
          each metric in metrics
            span.case__metric= metric.label + ': '
              span.case__metric-value= metric.value
        +button(buttonText, buttonLink)
    else
      .case__content
        span.case__type= type
        h2= title
        .case__metrics
          each metric in metrics
            span.case__metric= metric.label + ': '
              span.case__metric-value= metric.value
        +button(buttonText, buttonLink)
      .case__image
        img(src=imageSrc, alt=imageAlt)